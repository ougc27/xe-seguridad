<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_oauth_client_tree" model="ir.ui.view">
		<field name="name">muk_mcp.oauth.client.tree</field>
		<field name="model">muk_mcp.oauth.client</field>
		<field name="arch" type="xml">
			<tree create="false" edit="false">
				<field name="client_name"/>
				<field name="token_endpoint_auth_method"/>
				<field name="create_date"/>
				<field name="active"/>
			</tree>
		</field>
	</record>

	<record id="view_mcp_oauth_client_form" model="ir.ui.view">
		<field name="name">muk_mcp.oauth.client.form</field>
		<field name="model">muk_mcp.oauth.client</field>
		<field name="arch" type="xml">
			<form create="false" edit="false">
				<sheet>
					<div class="oe_title">
						<h1><field name="client_name"/></h1>
					</div>
					<group>
						<group>
							<field name="client_id"/>
							<field name="token_endpoint_auth_method"/>
							<field name="redirect_uris"/>
						</group>
						<group>
							<field name="create_date"/>
							<field name="active"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_mcp_oauth_client" model="ir.actions.act_window">
		<field name="name">OAuth Clients</field>
		<field name="res_model">muk_mcp.oauth.client</field>
		<field name="view_mode">tree,form</field>
	</record>

</odoo>
