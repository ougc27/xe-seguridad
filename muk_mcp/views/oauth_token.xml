<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_oauth_token_kanban" model="ir.ui.view">
		<field name="name">muk_mcp.oauth.token.kanban</field>
		<field name="model">muk_mcp.oauth.token</field>
		<field name="arch" type="xml">
			<kanban create="0" can_open="0">
				<field name="revoked"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click flex-row">
							<div>
								<div>
									<field name="name" class="fw-bold fs-5"/>
									<field name="create_date" class="ms-2 text-muted"/>
								</div>
								<small>
									Scope: <field name="scope"/>
									· Expires: <field name="expires_at"/>
								</small>
							</div>
							<button
								name="action_revoke"
								type="object"
								string="Revoke"
								class="btn btn-secondary ms-auto my-auto"
								invisible="revoked"
							/>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_mcp_oauth_token_tree" model="ir.ui.view">
		<field name="name">muk_mcp.oauth.token.tree</field>
		<field name="model">muk_mcp.oauth.token</field>
		<field name="arch" type="xml">
			<tree create="false">
				<field name="name"/>
				<field name="user_id"/>
				<field name="scope"/>
				<field name="expires_at"/>
				<field name="last_used"/>
				<field name="revoked"/>
			</tree>
		</field>
	</record>

	<record id="view_mcp_oauth_token_form" model="ir.ui.view">
		<field name="name">muk_mcp.oauth.token.form</field>
		<field name="model">muk_mcp.oauth.token</field>
		<field name="arch" type="xml">
			<form create="false" delete="false">
				<sheet>
					<div class="oe_title">
						<h1><field name="name" readonly="1"/></h1>
					</div>
					<group>
						<group>
							<field name="user_id" readonly="1"/>
							<field name="scope"/>
							<field name="rate_limit" readonly="1"/>
						</group>
						<group>
							<field name="create_date" readonly="1"/>
							<field name="expires_at" readonly="1"/>
							<field name="refresh_expires_at" readonly="1"/>
							<field name="last_used" readonly="1"/>
							<field name="revoked"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_mcp_oauth_token" model="ir.actions.act_window">
		<field name="name">OAuth Sessions</field>
		<field name="res_model">muk_mcp.oauth.token</field>
		<field name="view_mode">kanban,tree,form</field>
	</record>

</odoo>
