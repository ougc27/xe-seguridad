<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Un solo cron para todos los jobs: agregar una tabla nueva es agregar
        un registro de supabase.sync.job (con su propia frequency_minutes),
        nunca un ir.cron nuevo. El tick corre cada 5 minutos y cada job decide
        si ya le toca según su propia frecuencia configurada.
    -->
    <record id="ir_cron_supabase_sync_tick" model="ir.cron">
        <field name="name">Supabase Sync: tick</field>
        <field name="model_id" ref="model_supabase_sync_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_tick()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
