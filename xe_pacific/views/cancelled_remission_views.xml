<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_cancelled_remission_form" model="ir.ui.view">
        <field name="name">cancelled.remission.form</field>
        <field name="model">cancelled.remission</field>
        <field name="arch" type="xml">
            <form string="Cancelled Remission">
                <sheet>
                    <group>
                        <group>
                            <field name="picking_id" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="remission_folio" readonly="1"/>
                            <field name="remission_date" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="team_id" readonly="1"/>
                            <field name="warehouse_id" readonly="1"/>
                            <field name="cancelled_date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="cancelled_reason" readonly="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="tag_ids"
                                widget="many2many_tags"
                                options="{'color_field': 'color', 'no_create_edit': True}"
                                readonly="1"/>
                            <field name="comments" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cancelled_remission_tree" model="ir.ui.view">
        <field name="name">cancelled.remission.tree</field>
        <field name="model">cancelled.remission</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="picking_id"/>
                <field name="remission_folio"/>
                <field name="remission_date"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="warehouse_id"/>
                <field name="cancelled_date"/>
                <field name="user_id"/>
                <field name="cancelled_reason"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="comments"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_cancelled_remission_pivot" model="ir.ui.view">
        <field name="name">cancelled.remission.pivot</field>
        <field name="model">cancelled.remission</field>
        <field name="arch" type="xml">
            <pivot string="Cancelled Remissions">
                <field name="cancelled_reason" type="row"/>
                <field name="cancelled_date" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_cancelled_remission_graph" model="ir.ui.view">
        <field name="name">cancelled.remission.graph</field>
        <field name="model">cancelled.remission</field>
        <field name="arch" type="xml">
            <graph string="Cancelled Remissions" type="bar" stacked="True">
                <field name="cancelled_date" type="row" interval="week"/>
                <field name="warehouse_id" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_cancelled_remission_search" model="ir.ui.view">
        <field name="name">cancelled.remission.search</field>
        <field name="model">cancelled.remission</field>
        <field name="arch" type="xml">
            <search string="Cancelled Remission Search">
                <field name="remission_folio"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="team_id"/>
                <field name="warehouse_id"/>
                <field name="user_id"/>
                <field name="cancelled_reason"/>
                <filter string="Cancelled Date" name="filter_cancelled_date" date="cancelled_date"/>
                <separator/>
                <filter string="From Ticket" name="filter_from_ticket_yes" domain="[('is_from_ticket', '=', True)]"/>
                <filter string="Not From Ticket" name="filter_from_ticket_no" domain="[('is_from_ticket', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Cancellation Reason" name="group_cancelled_reason" context="{'group_by': 'cancelled_reason'}"/>
                    <filter string="Customer" name="group_partner_id" context="{'group_by': 'partner_id'}"/>
                    <filter string="Sales Team" name="group_team_id" context="{'group_by': 'team_id'}"/>
                    <filter string="Warehouse" name="group_warehouse_id" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="From Ticket" name="group_from_ticket" context="{'group_by': 'is_from_ticket'}"/>
                    <filter string="Cancelled Date" name="group_cancelled_date" context="{'group_by': 'cancelled_date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cancelled_remission" model="ir.actions.act_window">
        <field name="name">Cancelled Remissions</field>
        <field name="res_model">cancelled.remission</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="view_id" ref="view_cancelled_remission_tree"/>
        <field name="search_view_id" ref="view_cancelled_remission_search"/>
    </record>

    <menuitem id="menu_cancelled_remission"
        name="Cancelled Remissions"
        action="action_cancelled_remission"
        parent="stock.menu_stock_warehouse_mgmt"
        sequence="4"/>
</odoo>
