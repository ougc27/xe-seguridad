<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_fifo_reconcile" model="ir.ui.view">
        <field name="name">account.payment.form.fifo.reconcile</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="fifo_partner_enabled" invisible="1"/>
                <!-- Restricción solo a nivel vista: el booleano aparece únicamente para el grupo -->
                <field name="fifo_reconcile_release"
                       widget="boolean_toggle"
                       groups="xe_fifo_payment_reconcile.group_fifo_reconcile_release"
                       invisible="not fifo_partner_enabled or state != 'posted' or is_reconciled"/>
                <field name="fifo_reconcile_state"
                       widget="badge"
                       invisible="not fifo_reconcile_state"
                       decoration-info="fifo_reconcile_state in ('pending', 'in_progress')"
                       decoration-success="fifo_reconcile_state == 'done'"
                       decoration-warning="fifo_reconcile_state == 'done_residual'"
                       decoration-danger="fifo_reconcile_state == 'error'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_fifo_reconcile" model="ir.ui.view">
        <field name="name">account.payment.tree.fifo.reconcile</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="fifo_reconcile_state"
                       widget="badge"
                       optional="hide"
                       decoration-info="fifo_reconcile_state in ('pending', 'in_progress')"
                       decoration-success="fifo_reconcile_state == 'done'"
                       decoration-warning="fifo_reconcile_state == 'done_residual'"
                       decoration-danger="fifo_reconcile_state == 'error'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_fifo_reconcile" model="ir.ui.view">
        <field name="name">account.payment.search.fifo.reconcile</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='reconciled']" position="after">
                <separator/>
                <filter string="FIFO: Released" name="fifo_released"
                        domain="[('fifo_reconcile_release', '=', True)]"/>
                <separator/>
                <filter string="FIFO: Pending" name="fifo_state_pending"
                        domain="[('fifo_reconcile_state', '=', 'pending')]"/>
                <filter string="FIFO: In Progress" name="fifo_state_in_progress"
                        domain="[('fifo_reconcile_state', '=', 'in_progress')]"/>
                <filter string="FIFO: Done" name="fifo_state_done"
                        domain="[('fifo_reconcile_state', '=', 'done')]"/>
                <filter string="FIFO: Done with Residual" name="fifo_state_done_residual"
                        domain="[('fifo_reconcile_state', '=', 'done_residual')]"/>
                <filter string="FIFO: Error" name="fifo_state_error"
                        domain="[('fifo_reconcile_state', '=', 'error')]"/>
                <filter string="FIFO State" name="groupby_fifo_reconcile_state"
                        domain="[]" context="{'group_by': 'fifo_reconcile_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
