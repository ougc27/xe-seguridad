<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Respaldo cada 5 minutos: el encadenamiento real entre lotes lo hace
             ir.cron._trigger() desde account.payment. -->
        <record id="ir_cron_fifo_reconcile" model="ir.cron">
            <field name="name">FIFO Reconcile: Apply Released Customer Payments</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="state">code</field>
            <field name="code">model._cron_fifo_reconcile()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
