<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="special_door_request_wizard_view_form" model="ir.ui.view">
        <field name="name">special.door.request.wizard.view.form</field>
        <field name="model">special.door.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Solicitud de puerta de medida especial">
                <field name="step" invisible="1"/>
                <field name="sale_order_id" invisible="1"/>
                <!-- Paso 1: captura -->
                <div invisible="step != 'edit'">
                    <div class="alert alert-info mb-2" role="alert">
                        En las filas de puerta especial captura modelo, ancho y alto en centímetros enteros, y color.
                        En las de SKU existente solo se ajusta la cantidad.
                        Desactiva “Incluir” en las filas que no quieras pedir.
                    </div>
                    <!-- En una lista editable los campos de solo lectura no se envían en el onchange:
                         force_save para que el SKU se calcule en pantalla -->
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom" create="0" delete="0" decoration-muted="not include">
                            <field name="sale_line_id" column_invisible="1" force_save="1"/>
                            <field name="is_placeholder" column_invisible="1" force_save="1"/>
                            <field name="existing_product_id" column_invisible="1"/>
                            <field name="include" widget="boolean_toggle" width="73px"/>
                            <field name="product_id" string="Producto en OV" readonly="1" force_save="1"
                                   options="{'no_open': True}"/>
                            <field name="model_id" width="115px" readonly="not is_placeholder"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="width" readonly="not is_placeholder"/>
                            <field name="height" readonly="not is_placeholder"/>
                            <field name="color_id" width="115px" readonly="not is_placeholder"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="opening" readonly="1" force_save="1"/>
                            <field name="quantity" string="Cantidad"/>
                            <field name="sku" width="130px"/>
                            <field name="existing_status" string="¿Ya existe?" widget="badge"
                                   decoration-success="existing_status == 'active'"
                                   decoration-warning="existing_status in ('pending', 'archived')"
                                   decoration-info="existing_status == 'new'"/>
                        </tree>
                    </field>
                    <group>
                        <field name="notes" placeholder="Información adicional para compras internacionales"/>
                    </group>
                </div>
                <!-- Paso 2: advertencias -->
                <div invisible="step != 'confirm'">
                    <field name="warning_message" nolabel="1" readonly="1"/>
                </div>
                <footer>
                    <button name="action_submit" string="Crear solicitud" type="object" class="btn-primary"
                            invisible="step != 'edit'"/>
                    <button name="action_confirm_warnings" string="Confirmar y crear" type="object"
                            class="btn-primary" invisible="step != 'confirm'"/>
                    <button name="action_back" string="Regresar" type="object" invisible="step != 'confirm'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
