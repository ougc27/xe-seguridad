<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.xe.special.door.request</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="show_special_door_button" invisible="1"/>
                <button name="action_open_special_door_request"
                        string="Solicitar puerta especial"
                        type="object"
                        groups="sales_team.group_sale_salesman"
                        invisible="not show_special_door_button"/>
            </xpath>
        </field>
    </record>
</odoo>
