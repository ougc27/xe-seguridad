msgstr "%(no_pack)s sin pack o sin venta relacionada (nada que hacer)."

#. module: xe_meli_connector
#: code:addons/xe_meli_connector/models/sale_order.py:0
msgid ""
"%(queued)s venta(s) de pack puesta(s) en cola para revisión — se corrigen "
"solas en segundo plano, sin afectar las que ya están completas."
msgstr ""
"%(queued)s venta(s) de pack puesta(s) en cola para revisión — se corrigen "
"solas en segundo plano, sin afectar las que ya están completas."

#. module: xe_meli_connector
#: code:addons/xe_meli_connector/models/meli_invoice_document.py:0
msgid ""
"%(queued)s venta(s) puesta(s) en cola para revisión de producto faltante."
msgstr ""
"%(queued)s venta(s) puesta(s) en cola para revisión de producto faltante."

