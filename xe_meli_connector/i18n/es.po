msgstr "Nota de crédito de Mercado Libre %(document)s (orden %(order_id)s)"

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid "Mercado Libre credit note %s"
msgstr "Nota de crédito de Mercado Libre %s"

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for order %(order_id)s "
"(one individual order within this pack), but its product line(s) could not "
"be found on invoice %(invoice)s — review manually."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para el pedido "
"%(order_id)s (un pedido individual dentro de este pack), pero no se "
"encontraron sus línea(s) de producto en la factura %(invoice)s — revisar "
"manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for order %(order_id)s "
"(one individual order within this pack), but there is no posted invoice yet "
"to apply it to — review manually."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para el pedido "
"%(order_id)s (un pedido individual dentro de este pack), pero todavía no hay"
" una factura contabilizada a la cual aplicarla — revisar manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for order %(order_id)s"
" (one individual order within this pack), but its current status could not"
" be confirmed (API call failed) — review manually."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para el pedido "
"%(order_id)s (un pedido individual dentro de este pack), pero no se pudo "
"confirmar su estatus actual (falló la llamada a la API) — revisar "
"manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for order %(order_id)s"
" (one individual order within this pack) — review manually and apply it; a"
" non-Full pack only automates a credit note when Mercado Libre confirms a"
" partial refund for that specific order."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para el pedido "
"%(order_id)s (un pedido individual dentro de este pack) — revisar y "
"aplicar manualmente; en un pack no Full solo se automatiza la nota de "
"crédito cuando Mercado Libre confirma un reembolso parcial para ese pedido "
"específico."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for this order — review"
" manually and apply it; credit notes are not automated for non-Full orders."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para esta venta — "
"revisar y aplicar manualmente; las notas de crédito no están automatizadas "
"para pedidos no Full."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s) for this order, but "
"there is no posted invoice yet to apply it to — review manually."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s) para esta venta, "
"pero todavía no hay una factura contabilizada a la cual aplicarla — revisar "
"manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated a credit note (%(document)s), but its own order id "
"(%(order_id)s) could not be matched to any line on this pack's consolidated "
"order — review manually."
msgstr ""
"Mercado Libre generó una nota de crédito (%(document)s), pero su propio "
"order id (%(order_id)s) no se pudo relacionar con ninguna línea de la venta "
"consolidada de este pack — revisar manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated another credit note (%(document)s) for order "
"%(order_id)s (one individual order within this pack), but a credit note "
"already covers its own line(s) — review manually, this new document was not "
"applied automatically."
msgstr ""
"Mercado Libre generó otra nota de crédito (%(document)s) para el pedido "
"%(order_id)s (un pedido individual dentro de este pack), pero una nota de "
"crédito ya cubre sus propias línea(s) — revisar manualmente, este nuevo "
"documento no se aplicó automáticamente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre generated another credit note (%(document)s) for this order, "
"but a credit note already exists for it — review manually, this new document"
" was not applied automatically."
msgstr ""
"Mercado Libre generó otra nota de crédito (%(document)s) para esta venta, "
"pero ya existe una nota de crédito para ella — revisar manualmente, este "
"nuevo documento no se aplicó automáticamente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre issued a new invoice document (%(new)s) for this order, but a "
"live credit note (%(credit_note)s) from a prior partial cancellation already"
" exists — automatic refacturación was skipped to avoid corrupting that "
"credit note's relation to the invoice it reverses; review manually."
msgstr ""
"Mercado Libre emitió un nuevo documento de factura (%(new)s) para esta "
"venta, pero ya existe una nota de crédito viva (%(credit_note)s) de una "
"cancelación parcial previa — se omitió la refacturación automática para no "
"corromper la relación de esa nota de crédito con la factura que revierte; "
"revisar manualmente."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre issued a new invoice document (%(new)s) replacing the one this"
" order's invoice %(old)s reflected — the old invoice was cancelled."
msgstr ""
"Mercado Libre emitió un nuevo documento de factura (%(new)s) reemplazando al"
" que reflejaba la factura %(old)s de esta venta — la factura anterior fue "
"cancelada."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre order %(order_id)s — one individual order within this active "
"pack — reported 'cancelled' again. Its stock was already returned in an "
"earlier run (this looks like a repeated notification) — nothing new to "
"return; the sale itself and this pack's other sibling(s) were left "
"completely untouched.<br/>Line(s): %(product_lines)s."
msgstr ""
"El pedido de Mercado Libre %(order_id)s — un pedido individual dentro de "
"este pack activo — reportó 'cancelled' de nuevo. Su inventario ya se "
"devolvió en una corrida anterior (parece una notificación repetida) — nada "
"nuevo que devolver; la venta misma y los demás pedidos individuales de este "
"pack se dejaron completamente sin tocar.<br/>Línea(s): %(product_lines)s."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre order %(order_id)s — one individual order within this active "
"pack — was cancelled, but it never had any line(s) of its own on this "
"consolidated order (every one of its SKUs is still unmapped) — no inventory "
"or invoice action was taken, there was nothing to touch. Review the SKU "
"mapping for this order manually."
msgstr ""
"El pedido de Mercado Libre %(order_id)s — un pedido individual dentro de "
"este pack activo — fue cancelado, pero nunca tuvo línea(s) propia(s) en esta"
" venta consolidada (todos sus SKU siguen sin mapear) — no se tocó inventario"
" ni factura, no había nada que tocar. Revisar manualmente el mapeo de SKU de"
" este pedido."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre order %(order_id)s — one individual order within this active "
"pack — was cancelled. It had no delivered stock to return (its own outbound "
"transfer never completed) — its own line's ordered quantity/amount was left "
"untouched (never edited by this automation); the sale itself and this pack's"
" other sibling(s) were left completely untouched.<br/>Line(s): "
"%(product_lines)s."
msgstr ""
"El pedido de Mercado Libre %(order_id)s — un pedido individual dentro de "
"este pack activo — fue cancelado. No tenía inventario entregado que devolver"
" (su propia transferencia de salida nunca se completó) — la cantidad/monto "
"de su propia línea se dejó sin tocar (nunca editada por esta "
"automatización); la venta misma y los demás pedidos individuales de este "
"pack se dejaron completamente sin tocar.<br/>Línea(s): %(product_lines)s."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre order %(order_id)s — one individual order within this active "
"pack — was cancelled/returned. Only its own stock was returned; the sale "
"itself and this pack's other sibling(s) were left completely "
"untouched.<br/>Line(s): %(product_lines)s."
msgstr ""
"El pedido de Mercado Libre %(order_id)s — un pedido individual dentro de "
"este pack activo — fue cancelado/devuelto. Solo se devolvió su propio "
"inventario; la venta misma y los demás pedidos individuales de este pack se "
"dejaron completamente sin tocar.<br/>Línea(s): %(product_lines)s."

#. module: xe_meli_connector
#: model:ir.model.fields,help:xe_meli_connector.field_sale_order__meli_pack_id
msgid ""
"Mercado Libre pack ID, when the order is part of a cart. Used to upload the "
"invoice via /packs/$PACK_ID/fiscal_documents."
msgstr ""
"ID de pack de Mercado Libre, cuando el pedido es parte de un carrito. Se usa"
" para subir la factura vía /packs/$PACK_ID/fiscal_documents."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reported this order as already <b>cancelled</b> when it was "
"first imported. It was created, confirmed, and delivered as a precaution, "
"then automatically cancelled and reconciled:<br/>%s"
msgstr ""
"Mercado Libre reportó esta orden como ya <b>cancelada</b> cuando se importó "
"por primera vez. Se creó, confirmó y entregó como precaución, y luego se "
"canceló y reconcilió automáticamente:<br/>%s"

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reported this order as already cancelled when it was first "
"imported. It was created, confirmed, and delivered as a precaution, but "
"automatic cancellation processing failed — review manually whether to cancel"
" it and apply any invoice/credit note."
msgstr ""
"Mercado Libre reportó esta orden como ya cancelada cuando se importó por "
"primera vez. Se creó, confirmó y entregó como precaución, pero el "
"procesamiento automático de la cancelación falló — revisar manualmente si "
"cancelarla y aplicar cualquier factura/nota de crédito."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reported this pack order as already cancelled when it was "
"first imported. It was created, confirmed, and delivered as a precaution, "
"but automatic cancellation processing was skipped because this is part of a "
"pack — review manually whether to cancel it and apply any invoice/credit "
"note, and whether other siblings are still expected."
msgstr ""
"Mercado Libre reportó este pedido de pack como ya cancelado cuando se "
"importó por primera vez. Se creó, confirmó y entregó como precaución, pero "
"el procesamiento automático de cancelación se omitió por ser parte de un "
"pack — revisar manualmente si cancelarlo y aplicar cualquier factura/nota de"
" crédito, y si todavía se esperan otros pedidos individuales."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reports that individual order %(order_id)s (part of this "
"active pack) was cancelled, but automatic processing failed. Review manually"
" — the sale itself and every sibling's own line were left untouched."
msgstr ""
"Mercado Libre reporta que el pedido individual %(order_id)s (parte de este "
"pack activo) fue cancelado, pero el procesamiento automático falló. Revisar "
"manualmente — la venta misma y la línea de cada pedido individual se dejaron"
" sin tocar."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reports that this order changed to status <b>%(status)s</b>."
msgstr ""
"Mercado Libre reporta que esta orden cambió al estatus <b>%(status)s</b>."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reports this order was <b>cancelled</b>, but automatic "
"processing failed — review manually whether the sale needs to be cancelled, "
"stock returned, and/or a credit note issued."
msgstr ""
"Mercado Libre reporta que esta orden fue <b>cancelada</b>, pero el "
"procesamiento automático falló — revisar manualmente si la venta debe "
"cancelarse, devolver inventario y/o emitir una nota de crédito."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"Mercado Libre reports this order was <b>cancelled</b>. Handled "
"automatically:<br/>%s"
msgstr ""
"Mercado Libre reporta que esta orden fue <b>cancelada</b>. Manejado "
"automáticamente:<br/>%s"

#. module: xe_meli_connector
#: model:ir.model.fields,help:xe_meli_connector.field_res_partner__meli_buyer_id
#: model:ir.model.fields,help:xe_meli_connector.field_res_users__meli_buyer_id
msgid ""
"Mercado Libre's numeric buyer ID (from the order's buyer.id). Identifies the"
" 'master' contact created for a Mercado Libre buyer on custom-shipping "
"orders (XE manages delivery itself) — see "
"res.partner._meli_find_or_create_delivery_contact(). Left empty on every "
"other contact."
msgstr ""
"ID numérico del comprador de Mercado Libre (del buyer.id del pedido). "
"Identifica el contacto 'maestro' creado para un comprador de Mercado Libre "
"en pedidos con envío personalizado (XE maneja la entrega). Vacío en "
"cualquier otro contacto."

#. module: xe_meli_connector
#: model:ir.model.fields,help:xe_meli_connector.field_meli_invoice_document__status
msgid ""
"Mercado Libre's own status for this document — seen in practice "
"(2026-09-04): 'authorized'. The seller-panel UI also shows "
"'rechazado'/'cancelado' as possible states (a document can be cancelled "
"outright by Mercado Libre, independent of transaction_type — noticed by the "
"user 2026-09-04: not every reversal shows up as a nota_de_credito). Only "
"known when this document arrived via the 'invoices' webhook (the metadata "
"call that provides it) — never populated for documents fetched by the date-"
"range recovery wizard, which only gets the raw XML, not this metadata."
msgstr ""
"Estatus propio de este documento en Mercado Libre — visto en la práctica: "
"'authorized'. El panel de vendedores también muestra 'rechazado'/'cancelado'"
" como estatus posibles (un documento puede ser cancelado directamente por "
"Mercado Libre, sin importar el transaction_type). Solo se conoce cuando este"
" documento llegó vía el webhook de 'invoices' — nunca se llena para "
"documentos obtenidos por el asistente de recuperación por rango de fechas, "
"que solo obtiene el XML crudo, no estos metadatos."

#. module: xe_meli_connector
#: model:ir.actions.server,name:xe_meli_connector.ir_cron_meli_poll_claims_ir_actions_server
