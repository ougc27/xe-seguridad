"Warehouse used when the order's shipment is Full (logistic_type = "
"fulfillment)."
msgstr ""
"Almacén usado cuando el envío del pedido es Full (logistic_type = "
"fulfillment)."

#. module: xe_meli_connector
#: model:ir.model.fields,field_description:xe_meli_connector.field_meli_config__website_message_ids
msgid "Website Messages"
msgstr "Mensajes del Sitio Web"

#. module: xe_meli_connector
#: model:ir.model.fields,help:xe_meli_connector.field_meli_config__website_message_ids
