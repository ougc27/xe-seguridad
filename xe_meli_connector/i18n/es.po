#. module: xe_meli_connector
#: model:ir.actions.server,name:xe_meli_connector.ir_cron_meli_poll_orders_ir_actions_server
msgid "Mercado Libre: Poll Recent Orders (backup)"
msgstr "Mercado Libre: Consultar Órdenes Recientes (respaldo)"

#. module: xe_meli_connector
#: model:ir.actions.server,name:xe_meli_connector.ir_cron_meli_poll_invoices_ir_actions_server
