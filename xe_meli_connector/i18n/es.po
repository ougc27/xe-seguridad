#. module: xe_meli_connector
#: model:ir.model.fields,help:xe_meli_connector.field_sale_order__meli_buyer_id
msgid ""
"This order's buyer id, saved only for custom-shipping orders — same purpose "
"as meli_shipping_id, and the same value res.partner.meli_buyer_id uses to "
"identify the buyer's master contact."
msgstr ""
"El ID de comprador de este pedido, guardado solo para pedidos con envío "
"personalizado — mismo propósito que meli_shipping_id, y el mismo valor que "
"usa res.partner.meli_buyer_id para identificar el contacto maestro del "
"comprador."

#. module: xe_meli_connector
#. odoo-python
#: code:addons/xe_meli_connector/models/sale_order.py:0
#, python-format
msgid ""
"This order's invoice is already posted — the new line above may need manual "
