<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meli_quarantine_return_wizard_form" model="ir.ui.view">
        <field name="name">meli.quarantine.return.wizard.form</field>
        <field name="model">meli.quarantine.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Physical Return">
                <field name="sale_order_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <field name="location_id"/>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="product_id" readonly="1"/>
                        <field name="max_quantity" readonly="1"/>
                        <field name="quantity"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            confirm="This moves real inventory into the quarantine location. Are you sure?"/>
                    <button name="action_settle" type="object"
                            string="Settle"
                            invisible="sale_order_id.meli_stock_return_state != 'partial'"
                            confirm="Are you sure? This product will be treated as never coming back."/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
