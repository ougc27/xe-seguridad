<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meli_manual_import_wizard_form" model="ir.ui.view">
        <field name="name">meli.manual.import.wizard.form</field>
        <field name="model">meli.manual.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Mercado Libre Order">
                <group>
                    <field name="order_id" placeholder="e.g. 2000018165886068"/>
                </group>
                <footer>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meli_manual_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Order</field>
        <field name="res_model">meli.manual.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(6, 0, [ref('group_meli_user')])]"/>
    </record>

    <menuitem id="menu_meli_manual_import"
        name="Import Order"
        parent="menu_meli_root"
        action="action_meli_manual_import_wizard"
        sequence="7"
        groups="group_meli_user"/>

</odoo>
