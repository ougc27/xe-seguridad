<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meli_invoice_recovery_wizard_form" model="ir.ui.view">
        <field name="name">meli.invoice.recovery.wizard.form</field>
        <field name="model">meli.invoice.recovery.wizard</field>
        <field name="arch" type="xml">
            <form string="Rescue Mercado Libre Invoices">
                <p>
                    Searches, among the Mercado Libre orders in this date
                    range, for any invoice or credit note Mercado Libre
                    already issued and imports it into
                    "Mercado Libre Invoicing".
                </p>
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_recover" type="object"
                            string="Rescue" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_meli_invoice_recovery_wizard" model="ir.actions.act_window">
        <field name="name">Rescue Invoices</field>
        <field name="res_model">meli.invoice.recovery.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(6, 0, [ref('group_meli_user')])]"/>
    </record>

    <menuitem id="menu_meli_invoice_recovery"
        name="Rescue Invoices"
        parent="menu_meli_root"
        action="action_meli_invoice_recovery_wizard"
        sequence="12"
        groups="group_meli_user"/>

</odoo>
