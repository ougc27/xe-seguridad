<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meli_config_company_rule" model="ir.rule">
        <field name="name">Mercado Libre Config: multi-company</field>
        <field name="model_id" ref="model_meli_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="meli_claim_company_rule" model="ir.rule">
        <field name="name">Mercado Libre Claim: multi-company</field>
        <field name="model_id" ref="model_meli_claim"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
