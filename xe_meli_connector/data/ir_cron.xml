<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_meli_refresh_tokens" model="ir.cron">
            <field name="name">Mercado Libre: Refresh OAuth Tokens</field>
            <field name="model_id" ref="model_meli_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_tokens()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_meli_poll_invoices" model="ir.cron">
            <field name="name">Mercado Libre: Reconcile Missed Invoice Notifications (backup)</field>
            <field name="model_id" ref="model_meli_config"/>
            <field name="state">code</field>
            <field name="code">model._cron_poll_invoices()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_meli_relink_orphaned_documents" model="ir.cron">
            <field name="name">Mercado Libre: Relink Orphaned Invoice Documents (backup)</field>
            <field name="model_id" ref="model_meli_invoice_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_relink_orphaned_documents()</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_meli_retry_unapplied_documents" model="ir.cron">
            <field name="name">Mercado Libre: Retry Unapplied Invoice Documents (backup)</field>
            <field name="model_id" ref="model_meli_invoice_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_unapplied_documents()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_meli_recover_orphaned_document_orders" model="ir.cron">
            <field name="name">Mercado Libre: Recover Orders for Orphaned Invoice Documents (backup)</field>
            <field name="model_id" ref="model_meli_invoice_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_recover_orphaned_document_orders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_meli_rescue_missing_xml_documents" model="ir.cron">
            <field name="name">Mercado Libre: Rescue Missing Invoice XML Files (backup)</field>
            <field name="model_id" ref="model_meli_invoice_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_rescue_missing_xml_documents()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
