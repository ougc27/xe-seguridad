<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sales_order_filter_meli" model="ir.ui.view">
        <field name="name">sale.order.list.select.meli</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <!-- Extends the base "Order" free-text search (name/
                 client_order_ref/partner) so pasting either a Mercado
                 Libre order id or a pack id — in Ventas or in Mercado
                 Libre > Pedidos, both of which use this same search view
                 — finds the matching sale order directly. Found in
                 practice 2026-09-08: neither id was searchable before,
                 even though both are stored as their own fields. -->
            <field name="name" position="attributes">
                <attribute name="filter_domain">
                    ['|', '|', '|', '|', ('name', 'ilike', self), ('client_order_ref', 'ilike', self), ('partner_id', 'child_of', self), ('meli_order_id', 'ilike', self), ('meli_pack_id', 'ilike', self)]
                </attribute>
            </field>
            <!-- 2026-09-19 user request: filterable marker set on a
                 sale as soon as a product from the same Mercado Libre
                 pack gets added to it after the fact — see that field's
                 own help text — so these can be found and double-
                 checked. -->
            <filter name="my_sale_orders_filter" position="after">
                <filter string="Mercado Libre: Product Added Later"
                        name="meli_pack_had_sibling_added"
                        domain="[('meli_pack_had_sibling_added', '=', True)]"/>
                <!-- 2026-09-19 user request: sale.meli_transaction_type
                     read from Mercado Libre's own invoice document
                     (transaction_type='sale' vs 'resale'/catalog) —
                     empty until that document arrives, see the field's
                     own help text. -->
                <filter string="Mercado Libre: Venta Sale"
                        name="meli_transaction_type_sale"
                        domain="[('meli_transaction_type', '=', 'sale')]"/>
                <filter string="Mercado Libre: Venta Resale"
                        name="meli_transaction_type_resale"
                        domain="[('meli_transaction_type', '=', 'resale')]"/>
                <!-- 2026-09-20 user request: visible/filterable shipping
                     scheme (Full / Traditional / Custom) — see that
                     field's own help text. -->
                <filter string="Mercado Libre: Envío Full"
                        name="meli_shipping_scheme_full"
                        domain="[('meli_shipping_scheme', '=', 'full')]"/>
                <filter string="Mercado Libre: Envío Tradicional"
                        name="meli_shipping_scheme_traditional"
                        domain="[('meli_shipping_scheme', '=', 'traditional')]"/>
                <filter string="Mercado Libre: Envío Custom"
                        name="meli_shipping_scheme_custom"
                        domain="[('meli_shipping_scheme', '=', 'custom')]"/>
                <!-- 2026-09-21 user request: "de mis ventas cuánto el
                     cupón cayó en mí, de cuánto fue el descuento y si
                     Mercado Libre en algunas el descuento cayó en él"
                     — see sale.order.meli_discount_amount/meli_
                     discount_ml_funded_amount's own help text. -->
                <filter string="Mercado Libre: Con Descuento/Cupón"
                        name="meli_has_discount"
                        domain="[('meli_discount_amount', '&gt;', 0)]"/>
                <filter string="Mercado Libre: Descuento Subsidiado por Mercado Libre"
                        name="meli_discount_ml_funded"
                        domain="[('meli_discount_ml_funded_amount', '&gt;', 0)]"/>
                <!-- 2026-09-25 (user-directed correction): must also
                     require state == 'cancel', not just meli_last_status
                     == 'cancelled' — that field can already read
                     'cancelled' (set by _meli_infer_cancelled_from_
                     credit_note the moment a credit-note document
                     arrives) BEFORE Phase 1 actually finishes applying
                     the credit note and cancelling the sale itself (e.g.
                     no posted invoice yet to credit against). This
                     filter is only meant to surface a sale that's
                     ALREADY fully cancelled — credit note applied AND
                     the sale itself cancelled — with just its physical
                     return still pending (meli_stock_return_state
                     unset/'partial' — never 'settled' either, a
                     deliberate human decision that it's done for good).
                     Group-gated the same as the wizard/button that acts
                     on it. -->
                <filter string="Mercado Libre: Devolución Física Pendiente"
                        name="meli_pending_physical_return"
                        groups="__export__.res_groups_226_2f47e690"
                        domain="[('state', '=', 'cancel'),
                                 ('meli_last_status', '=', 'cancelled'),
                                 ('meli_stock_return_state', 'not in', ('done', 'settled'))]"/>
            </filter>
        </field>
    </record>

</odoo>
