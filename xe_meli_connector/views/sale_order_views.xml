<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_meli" model="ir.ui.view">
        <field name="name">sale.order.form.meli</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="client_order_ref" position="after">
                <field name="meli_order_id" invisible="not meli_order_id" readonly="1"/>
                <field name="meli_pack_id" invisible="not meli_pack_id" readonly="1"/>
                <field name="meli_sync_source" invisible="not meli_sync_source" readonly="1"/>
                <field name="meli_has_unapplied_document" invisible="1"/>
                <field name="meli_stock_return_state" invisible="1"/>
                <field name="meli_has_refacturacion" invisible="not meli_has_refacturacion" readonly="1"/>
                <field name="meli_has_credit_note" invisible="not meli_has_credit_note" readonly="1"/>
                <field name="meli_last_status" invisible="not meli_last_status" readonly="1"/>
                <field name="meli_order_date_created" invisible="not meli_order_date_created" readonly="1"/>
                <field name="meli_order_date_closed" invisible="not meli_order_date_closed" readonly="1"/>
                <field name="meli_order_detail_url" widget="url" string="Open in Mercado Libre"
                       invisible="not meli_order_detail_url" text="Open Order"
                       groups="xe_meli_connector.group_meli_user"/>
                <field name="meli_portal_url" widget="url" string="Open in Mercado Libre"
                       invisible="not meli_portal_url" text="Open Messaging"
                       groups="xe_meli_connector.group_meli_user"/>
                <field name="meli_discount_amount" invisible="not meli_discount_amount" readonly="1"/>
                <field name="meli_discount_ml_funded_amount"
                       invisible="not meli_discount_ml_funded_amount" readonly="1"/>
            </field>
            <group name="sale_shipping" position="inside">
                <field name="meli_shipping_id" invisible="not meli_shipping_id" readonly="1"/>
            </group>
            <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="after">
                <field name="meli_order_id" optional="hide" readonly="1"/>
                <field name="meli_discount_amount" optional="hide" readonly="1"/>
                <field name="meli_discount_ml_funded_amount" optional="hide" readonly="1"/>
            </xpath>
            <xpath expr="//header/button[1]" position="before">
                <button name="action_meli_retry_sku_mapping" type="object"
                        string="Retry SKU Mapping"
                        class="btn-secondary" groups="xe_meli_connector.group_meli_user"
                        invisible="state != 'draft' or not meli_sync_source"/>
                <button name="action_meli_retry_invoicing_reconciliation" type="object"
                        string="Retry Invoicing"
                        class="btn-secondary" groups="xe_meli_connector.group_meli_user"
                        invisible="not meli_sync_source or not meli_has_unapplied_document"/>
                <button name="action_meli_open_quarantine_return_wizard" type="object"
                        string="Confirm Physical Return"
                        class="btn-secondary" groups="__export__.res_groups_226_2f47e690"
                        invisible="not meli_sync_source or meli_last_status != 'cancelled' or meli_stock_return_state == 'done'"/>
            </xpath>
        </field>
    </record>

    <record id="view_order_filter_meli" model="ir.ui.view">
        <field name="name">sale.order.search.meli</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <filter name="my_quotation" position="after">
                <separator/>
                <filter name="meli_auto_recovered" string="Meli: Auto-Recovered (No VentiApp)"
                        domain="[('meli_auto_recovered', '=', True)]"/>
                <filter name="meli_has_refacturacion" string="Meli: Refactured (Global + Nominal)"
                        domain="[('meli_has_refacturacion', '=', True)]"/>
                <filter name="meli_has_credit_note" string="Meli: Has Credit Note"
                        domain="[('meli_has_credit_note', '=', True)]"/>
            </filter>
        </field>
    </record>

    <record id="action_meli_orders_server" model="ir.actions.server">
        <field name="name">Orders</field>
        <field name="model_id" ref="model_meli_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_meli_orders()</field>
        <field name="groups_id" eval="[(6, 0, [ref('group_meli_user')])]"/>
    </record>

    <menuitem id="menu_meli_orders"
        name="Orders"
        parent="menu_meli_root"
        action="action_meli_orders_server"
        sequence="5"
        groups="group_meli_user"/>

</odoo>
