#. module: xe_l10n_mx_edi
#. odoo-python
#: code:addons/xe_l10n_mx_edi/models/account_move.py:0
#, python-format
msgid ""
"CFDI stamping skipped: the customer %(partner)s has its CFDI issued by a "
"third party (marketplace platform). The XML issued by the platform should "
"be related to this document instead."
msgstr ""
"Timbrado de CFDI omitido: el cliente %(partner)s tiene su CFDI emitido por "
"un tercero (plataforma del marketplace). El XML emitido por la plataforma "
"debe relacionarse con este documento en su lugar."

#. module: xe_l10n_mx_edi
#. odoo-python
#: code:addons/xe_l10n_mx_edi/models/account_move.py:0
#, python-format
msgid ""
"Cannot stamp %(doc)s.\n"
"\n"
"The CFDI for customer %(partner)s is issued by a third party (marketplace "
"platform). Stamping it from Odoo would create a duplicate document before "
"the SAT.\n"
"\n"
"The XML issued by the platform is related to this document afterwards."
msgstr ""
"No se puede timbrar %(doc)s.\n"
"\n"
"El CFDI del cliente %(partner)s lo emite un tercero (plataforma del "
"marketplace). Timbrarlo desde Odoo generaría un comprobante duplicado ante "
"el SAT.\n"
"\n"
"El XML emitido por la plataforma se relaciona con este documento después."

